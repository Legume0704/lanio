# Required for querying for IMDb IDs with file names.
# Get one free: https://www.themoviedb.org/settings/api
TMDB_API_KEY=YOUR-TMDB-API-KEY-HERE

# Strongly recommended to set a password if you expose this app on the public internet.
# You will be asked for this password on the home page which will then give you the full
# manifest URL and link to install in Stremio. All routes will use a token based on this
# password, adding a layer of security for your media.
# PASSWORD=YOUR-PASSWORD-HERE

# URL used in video stream URLs, must be reachable from wherever Stremio is running.
# Use your server's LAN IP or hostname, e.g.:
BASE_URL=http://192.168.1.10:8078

# Optional: public-facing URL for the manifest install link (home page + startup logs).
# Stremio requires HTTPS with a valid TLS certificate to install addons directly,
# so this should be an https:// URL if you're installing via Stremio's addon page.
# If you're using AIOStreams as a proxy, you can leave this unset; AIOStreams will
# reference this server's BASE_URL internally and handle TLS itself.
# PUBLIC_URL=https://stremio.yourdomain.com

# Required for Tailscale setup
# Generate here: https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=YOUR-TAILSCALE-AUTH-KEY-HERE 

# =================================================================================================
# Optional overrides
# =================================================================================================

# The port the http server will listen on
# PORT=8078

# Template URL for posters images served in the catalogs, keyed off of IMDB ID.
# By default, TMDB is used for poster images.
# POSTER_URL=https://btttr.cc/poster/imdb/poster-default/{imdb_id}.jpg

# run a full media library rescan on a cron schedule. Accepts standard
# 5-field cron ("0 3 * * *") meaning every day at 3:00am, plus 6- and 7-field
# forms that include seconds. The schedule is evaluated in the server's local
# time zone. Good for picking up files the file watcher may have missed.
# SCAN_CRON=0 3 * * *
